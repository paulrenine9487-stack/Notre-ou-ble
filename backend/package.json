{
  "name": "resonova-backend",
  "version": "1.0.0",
  "description": "Backend API for No Tre(ou)ble - Breath Management Portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --watch-path=controllers --watch-path=routes --watch-path=middleware --watch-path=services --watch-path=config --watch-path=utils --watch-path=server.js server.js",
    "init-db": "node config/initDb.js",
    "migrate": "node scripts/runMigrations.js migrate",
    "migrate:status": "node scripts/runMigrations.js status",
    "redis:start": "node scripts/startRedis.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.6.1",
    "opossum": "^10.0.0",
    "rate-limit-redis": "^6.0.2"
  }
}
